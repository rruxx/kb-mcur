[Unit]
Description=key-cursord — NumPad mouse navigation (NumLock+KPEnter toggle)
Documentation=https://github.com/xxx/key-cursor
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/key-cursor kp-nav
Restart=always
RestartSec=2

# Requires /dev/input/event* and /dev/uinput access.
# Either add the user to the input group,
# or run as root / grant CAP_SYS_ADMIN.
User=root
# Alternative: use a dedicated user (see below)
# User=key-cursord
# SupplementaryGroups=input
# AmbientCapabilities=CAP_SYS_ADMIN
# NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
