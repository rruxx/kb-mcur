[Unit]
Description=key-mcursord — NumPad mouse navigation (NumLock+KPEnter toggle)
Documentation=https://github.com/rruxx/key-mcursor https://gitee.com/rruxx/key-mcursor
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/key-mcursor kp-nav
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
